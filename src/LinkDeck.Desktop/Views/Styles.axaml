<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Button.tile">
    <Setter Property="Background" Value="{DynamicResource DeckTile}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="Height" Value="104" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DeckTileHover}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <!-- The tile being dragged: faded with a dashed outline, so it is clear what was picked up. -->
  <Style Selector="Button.tile.dragging">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Button.tile.dragging /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource DeckTileSelectedBorder}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.tile.selected">
    <Setter Property="Background" Value="{DynamicResource DeckTileSelected}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DeckTileSelectedBorder}" />
  </Style>
  <Style Selector="Button.tile.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DeckTileSelected}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DeckTileSelectedBorder}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource DeckMuted}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Margin" Value="0,10,0,4" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="#DC2626" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
</Styles>
