<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LinkDeck.Desktop.ViewModels"
        x:Class="LinkDeck.Desktop.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="LinkDeck settings"
        Width="980" Height="620" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True"
        Icon="avares://LinkDeck/Assets/linkdeck.ico">
  <DockPanel>
    <!-- Header: back to the launcher -->
    <Border DockPanel.Dock="Top" Padding="12,10,16,4">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button x:Name="BackButton" Content="← Back" Padding="12,6"
                ToolTip.Tip="Save changes and return to the launcher (Esc)"
                AutomationProperties.Name="Back to the launcher" />
        <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Bottom bar -->
    <Border DockPanel.Dock="Bottom" Padding="16,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DeckSurfaceBorder}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
          <TextBlock Foreground="{DynamicResource DeckWarning}" IsVisible="{Binding IsReadOnly}" TextWrapping="Wrap"
                     Text="Read-only: config.json is invalid or was written by a newer LinkDeck. Fix the file by hand; saving is disabled." />
          <TextBlock Text="{Binding Status}" IsVisible="{Binding HasStatus}" TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Revert" Command="{Binding RevertCommand}" IsEnabled="{Binding IsDirty}" />
          <Button Content="Save" Classes="accent" Command="{Binding SaveSettingsCommand}" IsEnabled="{Binding CanEdit}" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Margin="8,4,8,0">
      <TabItem Header="Items">
        <Grid ColumnDefinitions="220,260,*" Margin="0,8,0,8">
          <!-- Groups -->
          <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" Classes="label" Margin="0,0,0,6" Text="Groups" />
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="Add" Command="{Binding AddGroupCommand}" />
                <Button Content="Delete" Command="{Binding DeleteGroupCommand}" IsEnabled="{Binding HasSelectedGroup}" />
                <Button Content="↑" Command="{Binding MoveGroupUpCommand}" AutomationProperties.Name="Move group up" />
                <Button Content="↓" Command="{Binding MoveGroupDownCommand}" AutomationProperties.Name="Move group down" />
              </StackPanel>
              <StackPanel IsVisible="{Binding HasSelectedGroup}" Spacing="4">
                <TextBlock Text="Name" Classes="muted" FontSize="12" />
                <TextBox Text="{Binding SelectedGroup.Name, FallbackValue=''}" AutomationProperties.Name="Group name" />
                <TextBlock Text="Colour" Classes="muted" FontSize="12" />
                <DockPanel>
                  <Button x:Name="GroupColorButton" DockPanel.Dock="Right" Margin="4,0,0,0" Padding="8,5"
                          ToolTip.Tip="Choose on a colour wheel" AutomationProperties.Name="Choose group colour">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Border Width="14" Height="14" CornerRadius="7" BorderThickness="1"
                              BorderBrush="{DynamicResource DeckSurfaceBorder}"
                              Background="{Binding SelectedGroup.Swatch, FallbackValue={x:Null}}" />
                      <TextBlock Text="Choose…" />
                    </StackPanel>
                  </Button>
                  <TextBox Text="{Binding SelectedGroup.Color, FallbackValue=''}" Watermark="#3B82F6" AutomationProperties.Name="Group colour" />
                </DockPanel>
              </StackPanel>
            </StackPanel>
            <ListBox x:Name="GroupList" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                     AutomationProperties.Name="Groups">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:GroupEditorViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Swatch}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <!-- Items of the selected group -->
          <DockPanel Grid.Column="1" Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" Classes="label" Margin="0,0,0,6" Text="Items" />
            <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,8,0,0" IsVisible="{Binding HasSelectedItem}">
              <TextBlock Text="Move or copy the selected item to (or drag it onto a group; hold Ctrl to copy)" Classes="muted" FontSize="11" TextWrapping="Wrap" />
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="4,0,0,0">
                  <Button Content="Move" Command="{Binding MoveSelectedItemCommand}" />
                  <Button Content="Copy" Command="{Binding CopySelectedItemCommand}" />
                </StackPanel>
                <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding TransferTarget}" HorizontalAlignment="Stretch"
                          PlaceholderText="Group…" AutomationProperties.Name="Target group">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:GroupEditorViewModel">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </DockPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
              <Button Content="Add" Command="{Binding AddItemCommand}" />
              <Button Content="Delete" Command="{Binding DeleteItemCommand}" IsEnabled="{Binding HasSelectedItem}" />
              <Button Content="↑" Command="{Binding MoveItemUpCommand}" AutomationProperties.Name="Move item up" />
              <Button Content="↓" Command="{Binding MoveItemDownCommand}" AutomationProperties.Name="Move item down" />
            </StackPanel>
            <ListBox x:Name="ItemList" ItemsSource="{Binding SelectedGroup.Items, FallbackValue={x:Null}}" SelectedItem="{Binding SelectedItem}"
                     AutomationProperties.Name="Items">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ItemEditorViewModel">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text="{Binding Target}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <!-- Editor: one template instance per item, so switching items never writes one item's values into another. -->
          <ScrollViewer Grid.Column="2">
            <StackPanel Margin="0,0,8,0">
              <ContentControl x:Name="ItemEditor" Content="{Binding SelectedItem}">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:ItemEditorViewModel">
                    <StackPanel>
                      <TextBlock Classes="label" Margin="0,0,0,4" Text="Type" />
                      <ComboBox ItemsSource="{Binding Types}" SelectedIndex="{Binding TypeIndex}"
                                HorizontalAlignment="Stretch" AutomationProperties.Name="Item type" />
                      <TextBlock Classes="label" Text="Name" />
                      <TextBox Text="{Binding Name}" AutomationProperties.Name="Item name" />
                      <TextBlock Classes="label" Text="{Binding TargetLabel}" />
                      <TextBox Text="{Binding Target}" AutomationProperties.Name="Item target" />
                      <StackPanel IsVisible="{Binding IsPath}">
                        <TextBlock Classes="label" Text="Arguments (programs only)" />
                        <TextBox Text="{Binding Args}" AutomationProperties.Name="Arguments" />
                        <TextBlock Classes="label" Text="Working directory" />
                        <TextBox Text="{Binding WorkingDir}" AutomationProperties.Name="Working directory" />
                      </StackPanel>
                      <StackPanel IsVisible="{Binding IsRdp}">
                        <TextBlock Classes="label" Text="Username (optional; passwords are never stored)" />
                        <TextBox Text="{Binding Username}" AutomationProperties.Name="Username" />
                      </StackPanel>
                      <TextBlock Classes="label" Text="Tile colour (optional)" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Click="OnChooseItemColor" Padding="8,5" ToolTip.Tip="Choose on a colour wheel"
                                AutomationProperties.Name="Choose tile colour">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="14" Height="14" CornerRadius="7" BorderThickness="1"
                                    BorderBrush="{DynamicResource DeckSurfaceBorder}" Background="{Binding ColorSwatch}" />
                            <TextBlock Text="Choose…" />
                          </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding ColorHex}" VerticalAlignment="Center" Classes="muted" />
                        <Button Content="No colour" Command="{Binding ClearColorCommand}" IsVisible="{Binding HasColor}" Padding="8,5" />
                      </StackPanel>
                      <TextBlock Classes="label" Text="Icon file (optional)" />
                      <TextBox Text="{Binding Icon}" Watermark="Resolved automatically when empty"
                               AutomationProperties.Name="Icon file" />
                      <TextBlock Classes="error" Margin="0,10,0,0" Text="{Binding Error}" IsVisible="{Binding HasError}" />
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
              <TextBlock Classes="muted" FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap"
                         Text="Tip: drop links, files, folders, shortcuts or .rdp files onto this window to add them to the selected group. Drag items in the lists to reorder, or onto a group to move them (Ctrl = copy)." />
              <Button Margin="0,16,0,0" Content="Sort into type groups…" Command="{Binding SortIntoTypeGroupsCommand}"
                      ToolTip.Tip="Puts every item into a Web, Apps, Files &amp; folders or Remote desktop group (created when missing). Your other groups stay; Save to keep the result." />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="General">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,8,16,16" MaxWidth="560" HorizontalAlignment="Left">
          <TextBlock Classes="label" Text="Hotkey" />
          <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" RowDefinitions="Auto">
            <TextBlock Grid.Column="0" Text="Hold" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Modifiers}" SelectedIndex="{Binding HoldIndex}" MinWidth="100"
                      AutomationProperties.Name="Key to hold" />
            <TextBlock Grid.Column="2" Text="and tap" VerticalAlignment="Center" Margin="16,0,8,0" />
            <ComboBox Grid.Column="3" ItemsSource="{Binding Modifiers}" SelectedIndex="{Binding StepIndex}" MinWidth="100"
                      AutomationProperties.Name="Key to tap" />
          </Grid>
          <TextBlock Classes="muted" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="{Binding HotkeyText}" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Classes="muted" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="Alt means the left Alt key, so AltGr never opens LinkDeck. Other apps' Ctrl+Alt shortcuts keep working: pressing any other key cancels the gesture." />
          <CheckBox Margin="0,8,0,0" IsChecked="{Binding LaunchOnRelease}"
                    Content="Launch the selected item when the held key is released (after stepping)" />

          <TextBlock Classes="label" Text="Theme" />
          <ComboBox ItemsSource="{Binding Themes}" SelectedIndex="{Binding ThemeIndex}" MinWidth="260" />

          <TextBlock Classes="label" Text="Empty search order" />
          <ComboBox ItemsSource="{Binding SortModes}" SelectedIndex="{Binding SortModeIndex}" MinWidth="260" />

          <CheckBox Margin="0,14,0,0" Content="Start with Windows" IsChecked="{Binding StartWithWindows}" />
          <CheckBox Margin="0,6,0,0" IsChecked="{Binding KeepOpen}"
                    Content="Keep the launcher open (after launching or clicking elsewhere; Esc closes it)" />

          <TextBlock Classes="label" Text="Background opacity" />
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding BackgroundOpacityText}" Width="52" TextAlignment="Right"
                       VerticalAlignment="Center" />
            <Slider Minimum="50" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                    Value="{Binding BackgroundOpacityPercent}" AutomationProperties.Name="Background opacity" />
          </DockPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <TextBlock Text="Blur behind" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding BlurModes}" SelectedIndex="{Binding BlurIndex}" MinWidth="120"
                      AutomationProperties.Name="Blur behind" />
          </StackPanel>
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="Lower opacity makes the launcher see-through. Off keeps what is behind it sharp; Soft and Strong blur it (Windows cannot blur less than Soft). Tiles keep their own backdrop, so text stays readable." />

          <TextBlock Classes="label" Text="Launcher size (in tiles, like a terminal's columns × rows)" />
          <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Columns" VerticalAlignment="Center" Margin="0,0,8,0" />
            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding PopupColumns}" Minimum="2" Maximum="20"
                           Increment="1" FormatString="0" Width="120" AutomationProperties.Name="Columns" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Rows" VerticalAlignment="Center" Margin="0,8,8,0" />
            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding PopupRows}" Minimum="1" Maximum="15"
                           Increment="1" FormatString="0" Width="120" Margin="0,8,0,0"
                           IsEnabled="{Binding IsFixedHeight}" AutomationProperties.Name="Rows" />
            <CheckBox Grid.Row="1" Grid.Column="2" Margin="16,8,0,0" Content="Auto (fit content)" IsChecked="{Binding AutoHeight}" />
          </Grid>
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                     Text="Or drag any edge or corner of the launcher: it shows columns × rows while you drag and snaps to whole tiles." />

          <TextBlock Classes="label" Text="Configuration file" />
          <TextBlock Classes="muted" FontSize="12" Text="{Binding ConfigPath}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="Open config file" Command="{Binding OpenConfigFileCommand}" />
            <Button Content="Open config folder" Command="{Binding OpenConfigFolderCommand}" />
          </StackPanel>
          <TextBlock Classes="muted" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="Only load configuration files from sources you trust: items can start any program." />
        </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
