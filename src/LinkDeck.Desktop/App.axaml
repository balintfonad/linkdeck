<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LinkDeck.Desktop.App"
             Name="LinkDeck"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <StyleInclude Source="avares://LinkDeck/Views/Styles.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="DeckSurface" Color="#F7F8FA" />
          <SolidColorBrush x:Key="DeckSurfaceBorder" Color="#1F000000" />
          <SolidColorBrush x:Key="DeckTile" Color="#D9F7F8FA" />
          <SolidColorBrush x:Key="DeckTileHover" Color="#EEE9EBEF" />
          <SolidColorBrush x:Key="DeckTileSelected" Color="#263B82F6" />
          <SolidColorBrush x:Key="DeckTileSelectedBorder" Color="#3B82F6" />
          <SolidColorBrush x:Key="DeckMuted" Color="#5F6670" />
          <SolidColorBrush x:Key="DeckGlyph" Color="#4B5563" />
          <SolidColorBrush x:Key="DeckWarning" Color="#B45309" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="DeckSurface" Color="#1E2024" />
          <SolidColorBrush x:Key="DeckSurfaceBorder" Color="#33FFFFFF" />
          <SolidColorBrush x:Key="DeckTile" Color="#D91E2024" />
          <SolidColorBrush x:Key="DeckTileHover" Color="#EE2A2D33" />
          <SolidColorBrush x:Key="DeckTileSelected" Color="#403B82F6" />
          <SolidColorBrush x:Key="DeckTileSelectedBorder" Color="#60A5FA" />
          <SolidColorBrush x:Key="DeckMuted" Color="#A1A7B0" />
          <SolidColorBrush x:Key="DeckGlyph" Color="#C9CED6" />
          <SolidColorBrush x:Key="DeckWarning" Color="#FBBF24" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Type glyphs (drawn for LinkDeck, 24x24 grid). -->
      <StreamGeometry x:Key="GlyphGlobe">M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 Z M12,3.6 C13.4,5.2 14.4,7.5 14.7,10.2 L9.3,10.2 C9.6,7.5 10.6,5.2 12,3.6 Z M9.3,13.8 L14.7,13.8 C14.4,16.5 13.4,18.8 12,20.4 C10.6,18.8 9.6,16.5 9.3,13.8 Z M3.7,10.2 C4.2,7.1 6.3,4.6 9.1,3.6 C8.2,5.4 7.6,7.7 7.5,10.2 Z M16.5,10.2 C16.4,7.7 15.8,5.4 14.9,3.6 C17.7,4.6 19.8,7.1 20.3,10.2 Z M3.7,13.8 L7.5,13.8 C7.6,16.3 8.2,18.6 9.1,20.4 C6.3,19.4 4.2,16.9 3.7,13.8 Z M16.5,13.8 L20.3,13.8 C19.8,16.9 17.7,19.4 14.9,20.4 C15.8,18.6 16.4,16.3 16.5,13.8 Z</StreamGeometry>
      <StreamGeometry x:Key="GlyphFolder">M3,5 C3,4.4 3.4,4 4,4 L9.6,4 L11.6,6 L20,6 C20.6,6 21,6.4 21,7 L21,19 C21,19.6 20.6,20 20,20 L4,20 C3.4,20 3,19.6 3,19 Z M5,8 L5,18 L19,18 L19,8 Z</StreamGeometry>
      <StreamGeometry x:Key="GlyphGrip">M2,2 A1.5,1.5 0 1 0 2,5 A1.5,1.5 0 1 0 2,2 Z M7,2 A1.5,1.5 0 1 0 7,5 A1.5,1.5 0 1 0 7,2 Z M12,2 A1.5,1.5 0 1 0 12,5 A1.5,1.5 0 1 0 12,2 Z M2,7 A1.5,1.5 0 1 0 2,10 A1.5,1.5 0 1 0 2,7 Z M7,7 A1.5,1.5 0 1 0 7,10 A1.5,1.5 0 1 0 7,7 Z M12,7 A1.5,1.5 0 1 0 12,10 A1.5,1.5 0 1 0 12,7 Z</StreamGeometry>
      <StreamGeometry x:Key="GlyphResize">M10,0 L10,10 L0,10 Z M10,0 L10,2 L2,10 L0,10 Z</StreamGeometry>
      <StreamGeometry x:Key="GlyphMenu">M3,6 L21,6 L21,8 L3,8 Z M3,11 L21,11 L21,13 L3,13 Z M3,16 L21,16 L21,18 L3,18 Z</StreamGeometry>
      <StreamGeometry x:Key="GlyphMonitor">M2,4 L22,4 L22,17 L14,17 L14,19 L17,19 L17,21 L7,21 L7,19 L10,19 L10,17 L2,17 Z M4,6 L4,15 L20,15 L20,6 Z</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>
</Application>
